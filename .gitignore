*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

/src/generated/prisma

/scripts/system-voices
/scripts/seed/system-voices

__pycache__/

# Modal standalone scripts
chatterbox_tts.py
viterbox_tts.py
viterbox-integration-guide-v2.md

# Sentry Config File
.env.sentry-build-plugin

# Local CodeGraph index
/.codegraph/

# TexTone dev bridge logs
/tmp/
