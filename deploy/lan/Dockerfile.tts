FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir 'piper-tts==1.8.0' 'fastapi[standard]==0.124.4'
ARG VOICE_COMMIT=c10ece1aade47bb51c153c893d14e5bf8e5b7117
ARG VOICE_BASE=https://huggingface.co/rhasspy/piper-voices/resolve
RUN mkdir -p /voices \
    && curl -fL --retry 3 -o /voices/vi_VN-vais1000-medium.onnx \
       "$VOICE_BASE/$VOICE_COMMIT/vi/vi_VN/vais1000/medium/vi_VN-vais1000-medium.onnx" \
    && echo 'ec7c89e2c85f4d1edc24b6120c18aaf1bda614f06b511567eb9c7c0de15e2dab  /voices/vi_VN-vais1000-medium.onnx' | sha256sum -c - \
    && curl -fsSL --retry 3 -o /voices/vi_VN-vais1000-medium.onnx.json \
       "$VOICE_BASE/$VOICE_COMMIT/vi/vi_VN/vais1000/medium/vi_VN-vais1000-medium.onnx.json" \
    && echo 'fafb9da1354ed4b77c31af228ed41fb41cd825c14cffa105454b25e6ae751ee0  /voices/vi_VN-vais1000-medium.onnx.json' | sha256sum -c - \
    && curl -fsSL --retry 3 -o /voices/MODEL_CARD \
       "$VOICE_BASE/$VOICE_COMMIT/vi/vi_VN/vais1000/medium/MODEL_CARD" \
    && curl -fL --retry 3 -o /voices/en_US-lessac-medium.onnx \
       "$VOICE_BASE/$VOICE_COMMIT/en/en_US/lessac/medium/en_US-lessac-medium.onnx" \
    && echo '5efe09e69902187827af646e1a6e9d269dee769f9877d17b16b1b46eeaaf019f  /voices/en_US-lessac-medium.onnx' | sha256sum -c - \
    && curl -fsSL --retry 3 -o /voices/en_US-lessac-medium.onnx.json \
       "$VOICE_BASE/$VOICE_COMMIT/en/en_US/lessac/medium/en_US-lessac-medium.onnx.json" \
    && echo 'efe19c417bed055f2d69908248c6ba650fa135bc868b0e6abb3da181dab690a0  /voices/en_US-lessac-medium.onnx.json' | sha256sum -c - \
    && curl -fsSL --retry 3 -o /voices/MODEL_CARD_EN \
       "$VOICE_BASE/$VOICE_COMMIT/en/en_US/lessac/medium/MODEL_CARD"
RUN curl -fL --retry 3 -o /voices/en_US-ryan-medium.onnx \
       "$VOICE_BASE/$VOICE_COMMIT/en/en_US/ryan/medium/en_US-ryan-medium.onnx" \
    && echo 'abf4c274862564ed647ba0d2c47f8ee7c9b717d27bdad9219100eb310db4047a  /voices/en_US-ryan-medium.onnx' | sha256sum -c - \
    && curl -fsSL --retry 3 -o /voices/en_US-ryan-medium.onnx.json \
       "$VOICE_BASE/$VOICE_COMMIT/en/en_US/ryan/medium/en_US-ryan-medium.onnx.json" \
    && echo '44034c056cb15681b2ad494307c7f3f2e4499d1253c700c711fa0a4607ffe78d  /voices/en_US-ryan-medium.onnx.json' | sha256sum -c -
COPY fast_tts.py ./
EXPOSE 8803
CMD ["uvicorn", "fast_tts:api", "--host", "0.0.0.0", "--port", "8803", "--workers", "1", "--limit-concurrency", "4", "--no-access-log"]
